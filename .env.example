# Copy to .env.local. These are SERVER-ONLY variables: the Express server in server/index.ts
# proxies /api/backend/* to the backend and adds the keys, so they never reach the browser.

# Where the FastAPI backend lives.
BACKEND_URL=http://localhost:8000

# Must match fa-ritmo-api/.env EXTERNAL_API_KEY (sent as X-Api-Key).
EXTERNAL_API_KEY=

# Must match fa-ritmo-api/.env API_KEY (sent as API-Key). Optional: when empty,
# the logged-in user's JWT is used for the fleet/driver/partner/... routes.
API_KEY=
PORT=3003
